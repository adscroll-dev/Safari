# Copy to .env and fill in real values. Never commit .env.
PORT=8080
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRY_HOURS=24
# Leave empty for the in-memory dev store. Set to use PostgresStore:
DATABASE_URL=postgres://vyro:vyro@localhost:5432/vyro?sslmode=disable
# Redis-backed login rate limiting (v0.4). Leave both empty for the
# in-memory limiter. REDIS_URL wins over REDIS_ADDR when both are set.
# REDIS_URL=redis://localhost:6379
REDIS_ADDR=localhost:6379
CORS_ALLOW_ORIGINS=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
# Web Push (VAPID, v0.5). Leave both empty and the server generates an
# ephemeral pair per run (subscriptions break on restart; the server
# logs the ephemeral PUBLIC key, never the private one). For
# production, generate a pair once with any VAPID tool and set both:
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vyro@example.invalid
# Email verification (v0.7): 6-digit codes for registration and login.
# Defaults point at Gmail's SMTP relay (STARTTLS on 587). Set SMTP_USER
# to a Gmail address and SMTP_PASS to an app password (a normal Gmail
# password does not work with SMTP; create one at Google Account >
# Security > App passwords). SMTP_FROM defaults to SMTP_USER. Leave
# SMTP_USER empty and the server answers 503 from the endpoints that
# must send a code — it never fakes one. SMTP_ALLOW_NOAUTH=true skips
# SMTP AUTH and is only for a local test sink (see
# backend/scripts/smtp-sink); never enable it for a real relay.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_ALLOW_NOAUTH=false
# Preferred when outbound SMTP is unreliable on the host: set
# RESEND_API_KEY (a Resend API key, re_...) and the server sends codes
# through the Resend HTTPS API instead of SMTP. SMTP_FROM must then be
# a sender Resend accepts (onboarding@resend.dev works with no domain
# setup). SMTP stays as the fallback when RESEND_API_KEY is empty.
# Preferred on hosts that block outbound SMTP entirely (Render's free
# tier: an SMTP dial to smtp.gmail.com:587 times out): the Gmail API
# over HTTPS. Create a Google Cloud project, enable the Gmail API,
# make an OAuth client (Web application, redirect http://localhost:8080,
# scope gmail.send only), grant consent once, exchange the code for a
# refresh token, and set all three below. The server then sends codes
# through the Gmail API instead of Resend/SMTP. SMTP_FROM is the From
# address (the Gmail account that granted consent).
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REFRESH_TOKEN=
# RESEND_API_KEY=
# FCM push for the mobile app (Firebase Cloud Messaging). The server
# reads the Firebase Admin SDK service-account JSON ONLY from one of
# these two variables; leave both empty and FCM stays disabled (Web
# Push still works). FIREBASE_SERVICE_ACCOUNT_JSON holds the raw JSON
# (on Render: paste the JSON as the env var value); _PATH points at a
# secret file instead. Never commit the key or the JSON.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_PATH=
